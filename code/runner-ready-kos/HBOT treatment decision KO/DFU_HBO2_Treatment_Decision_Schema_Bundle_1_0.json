      "enum": [
        {
          "status": "completed",
          "result_id": "OUTPUT-01",
          "display_text": "Suggest against adding HBO₂.",
          "evidence_quality": "very-low",
          "recommendation_strength": "conditional",
          "rule_id": "ALG-02",
          "error_field": null,
          "source_reference": "Huang et al. (2015), Figure 6",
          "warnings": {}
        },
        {
          "status": "completed",
          "result_id": "OUTPUT-02",
          "display_text": "Suggest adding HBO₂ urgently after surgery.",
          "evidence_quality": "moderate",
          "recommendation_strength": "conditional",
          "rule_id": "ALG-03",
          "error_field": null,
          "source_reference": "Huang et al. (2015), Figure 6",
          "warnings": {}

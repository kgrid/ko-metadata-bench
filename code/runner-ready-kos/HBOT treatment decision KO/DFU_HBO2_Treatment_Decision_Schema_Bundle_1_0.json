{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kgrid.org/cks/dfu-hbo2-treatment-decision/schema-bundles/versions/1.0",
  "title": "DFU HBO2 Treatment Decision Runtime Schema Bundle Version 1.0",
  "description": "Normative runtime object profiles for the evaluateInputObject interoperability boundary. This bundle is distinct from the canonical test-vector schema.",
  "definitions": {
    "input": {
      "$id": "#input",
      "title": "Complete evaluateInputObject invocation input",
      "description": "The complete native object accepted by evaluateInputObject after an object exists. Unknown properties are permitted and ignored. Values are validated without coercion.",
      "type": "object",
      "required": [
        "dfu_confirmed",
        "wagner_grade",
        "acute_surgical_intervention",
        "not_healed_after_30_days"
      ],
      "properties": {
        "dfu_confirmed": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "wagner_grade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "acute_surgical_intervention": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "not_healed_after_30_days": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      },
      "additionalProperties": true
    },
    "result": {
      "$id": "#result",
      "title": "Complete evaluateInputObject unified result",

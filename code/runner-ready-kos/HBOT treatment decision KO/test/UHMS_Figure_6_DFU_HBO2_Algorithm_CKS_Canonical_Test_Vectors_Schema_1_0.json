          "coverage": [],
          "classification": "excluded—prohibited invocation with no CKS result"
        },
        {
          "behavior_id": "BND-02",
          "normative_reference": "3.5.1",
          "behavior": "Malformed serialization or character-decoding failure",
          "coverage": [],
          "classification": "excluded—failure occurs before the CKS invocation boundary"
        }
      ]

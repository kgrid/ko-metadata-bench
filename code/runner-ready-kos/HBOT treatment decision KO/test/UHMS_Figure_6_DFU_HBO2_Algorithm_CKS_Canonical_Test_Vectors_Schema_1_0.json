    "vectors": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/testVector"
      }
    },
    "applicability_contract": {
      "const": {
        "definition": "A vector is applicable when its input_fixture kind can be presented through the invocation mechanism included in the implementation's conformance claim.",
        "universally_applicable_fixture_kinds": [
          "absent",
          "json-object"
        ],
        "serialized_text_fixture_kind": "raw-json",
        "raw_json_test_ids": [
          "TC-15",
          "TC-38",
          "TC-39",
          "TC-40",
          "TC-41",
          "TC-42",
          "TC-43",
          "TC-44",
          "TC-45",
          "TC-46",
          "TC-49"
        ],
        "serialized_text_rule": "Every raw-json vector applies to an implementation that accepts serialized text at the invocation boundary or includes a serialized-text adapter in its conformance claim.",
        "native_object_only_exemption": "An implementation whose entire claimed invocation mechanism accepts only native unique-name objects is exempt from executing the listed raw-json vectors.",
        "semantic_obligation": "Fixture exemption does not waive ERR-06 or property-name comparison semantics. If any claimed environment, parser, adapter, or property-sequence interface can produce or preserve duplicate names, the implementation SHALL enforce those semantics and SHALL execute the raw-json vectors or behaviorally equivalent duplicate-preserving tests."
      }
    }

      "const": 51
    },
    "comparison": {
      "const": "deep equality of the complete expected_result object"
    },
    "fixture_contract": {
      "const": {
        "json-object": "The value is already a unique-name top-level object. Duplicate-property validation succeeds by construction.",
        "raw-json": "The text is syntactically valid JSON and SHALL be parsed with every decoded property-name occurrence preserved until duplicate-property validation completes.",
        "absent": "No top-level input object is presented to the function; validation returns ERR-01.",
        "duplicate_preservation": "A parser or adapter SHALL NOT collapse, overwrite, merge, or discard repeated property-name occurrences before Section 3.7 step 2.",
        "property_name_equality": "Compare decoded Unicode scalar-value sequences exactly, with no case folding, Unicode normalization, whitespace trimming, alias expansion, or locale rules.",
        "duplicate_name_order": "Compare decoded Unicode scalar values left to right by ascending numeric code point; when one name is an exact prefix of another, the shorter name sorts first."
      }
    },
    "validation_coverage": {
      "const": [
        {
          "behavior_id": "VAL-01",
          "normative_reference": "3.7 step 1",
          "behavior": "Absent input object",

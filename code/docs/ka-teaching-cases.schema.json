{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgrid.org/fair-ko-bench/ka-teaching-cases.schema.json",
  "title": "Knowledge Assembly teaching cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "assembly_id", "cases"],
  "properties": {
    "format_version": { "const": "1.0" },
    "assembly_id": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "answerMap": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^Q[0-9]+$": { "type": ["boolean", "string", "number"] }
      },
      "additionalProperties": false
    },
    "kaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "requested_at",
        "index_time",
        "subject_binding",
        "hbot_case_assertions",
        "margolis_first_visit_assessment"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "requested_at": { "type": "string", "format": "date-time" },
        "index_time": { "type": "string", "format": "date-time" },
        "subject_binding": { "type": "object" },
        "hbot_case_assertions": { "type": "object" },
        "margolis_first_visit_assessment": { "type": "object" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "label", "teaching_point", "fictional", "ka_request", "questionnaire_answers", "expected"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^case-[0-9]{2}$" },
        "label": { "type": "string", "minLength": 1 },
        "teaching_point": { "type": "string", "minLength": 1 },
        "fictional": { "const": true },
        "ka_request": { "$ref": "#/$defs/kaRequest" },
        "questionnaire_answers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wagner", "burden"],
          "properties": {
            "wagner": { "$ref": "#/$defs/answerMap" },
            "burden": { "$ref": "#/$defs/answerMap" }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate_result", "synthesis_rule_id", "target_classification"],
          "properties": {
            "gate_result": { "type": "string", "minLength": 1 },
            "synthesis_rule_id": { "type": ["string", "null"] },
            "target_classification": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
